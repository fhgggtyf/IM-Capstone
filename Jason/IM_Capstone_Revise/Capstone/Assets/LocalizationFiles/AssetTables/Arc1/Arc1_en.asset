  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: Arc1_en
  m_EditorClassIdentifier: 
  m_LocaleId:
    m_Code: en
  m_SharedData: {fileID: 11400000, guid: b9337267fdc92944ca13fcedc1ac1fb0, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 30030299136
    m_Localized: "Neas\u2026 Stop stalling by the window. It won\u2019t make them
      come faster"
    m_Metadata:
      m_Items: []
  - m_Id: 242526322688
    m_Localized: "They might be lost. If they see me by the window, they\u2019ll
      remember. They\u2019ll find their way back."
    m_Metadata:
      m_Items: []
  - m_Id: 304593633280
    m_Localized: "They will come back. But staying by the window is too dangerous.
      We can\u2019t let anyone know it\u2019s just us."
    m_Metadata:
      m_Items: []
  - m_Id: 28230647152640
    m_Localized: Did you look everywhere?
    m_Metadata:
      m_Items: []
  - m_Id: 751040298352640
    m_Localized: Did you look everywhere?
    m_Metadata:
      m_Items: []
  - m_Id: 16815965480431616
    m_Localized: "So? I don\u2019t need to eat. I\u2019m not hungry."
    m_Metadata:
      m_Items: []
  - m_Id: 16815892520513536
    m_Localized: "We\u2019re out of food. We haven\u2019t eaten properly since mom
      left."
    m_Metadata:
      m_Items: []
  - m_Id: 16815782583611392
    m_Localized: Why are you in the kitchen?
    m_Metadata:
      m_Items: []
  - m_Id: 16815633564184576
    m_Localized: "\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 1111835267956736
    m_Localized: "Empty\u2026 Cobwebs have formed in the corners."
    m_Metadata:
      m_Items: []
  - m_Id: 6395532695175168
    m_Localized: "Boring books and a whole lot of dust\u2026 What was I expecting?"
    m_Metadata:
      m_Items: []
  - m_Id: 10498430107660288
    m_Localized: Why are you out I thought I aksed you to stay inside
    m_Metadata:
      m_Items: []
  - m_Id: 10498613843341312
    m_Localized: strangers in our house
    m_Metadata:
      m_Items: []
  - m_Id: 10498722463232000
    m_Localized: Lets hide somewhere, maybe the neybors house. you go first ill take
      watch
    m_Metadata:
      m_Items: []
  - m_Id: 16651308924940288
    m_Localized: I am hungry I need to finnd something to eat.
    m_Metadata:
      m_Items: []
  - m_Id: 16816023907086336
    m_Localized: "We\u2019ll die if we don\u2019t eat."
    m_Metadata:
      m_Items: []
  - m_Id: 16816079318036480
    m_Localized: "I can find something. I promise. Just don\u2019t go. Stay here!"
    m_Metadata:
      m_Items: []
  - m_Id: 16816968325935104
    m_Localized: Spoiled milk, leftovers from forever ago (Probably not safe), and
      a rotten egg.
    m_Metadata:
      m_Items: []
  - m_Id: 16817176245972992
    m_Localized: "Candy wrappers and crumbs\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 16817268508078080
    m_Localized: Just stationary. How disappointing.
    m_Metadata:
      m_Items: []
  - m_Id: 16817403031990272
    m_Localized: 3 smashed skittles. What an odd number.
    m_Metadata:
      m_Items: []
  - m_Id: 16817613275672576
    m_Localized: "Nothing edible\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 16817670175600640
    m_Localized: "Mints\u2026 Better than nothing..."
    m_Metadata:
      m_Items: []
  - m_Id: 16961664759115776
    m_Localized: (Door closed sound) Kairo...?
    m_Metadata:
      m_Items: []
  - m_Id: 16961102755934208
    m_Localized: "There\u2019s a note on the table, hastily scribbled."
    m_Metadata:
      m_Items: []
  - m_Id: 16962072940392448
    m_Localized: "\"I promise I\u2019ll be back. I\u2019ll bring good food for us
      to eat, I absolutely promise. Maybe I\u2019ll run into mom and dad along the
      way. Just keep the door locked, the curtains closed, and stay upstairs in our
      bedroom. Don\u2019t make too much noise. I\u2019ll be back before you know
      it.\""
    m_Metadata:
      m_Items: []
  - m_Id: 16962534661959680
    m_Localized: (Crying)
    m_Metadata:
      m_Items: []
  - m_Id: 16963255046254592
    m_Localized: (Sounds of muffled speaking behind the front door)
    m_Metadata:
      m_Items: []
  - m_Id: 16964939394854912
    m_Localized: "\"It ain\u2019t opening. No one is in the house you said?\""
    m_Metadata:
      m_Items: []
  - m_Id: 16964987331555328
    m_Localized: "\"I saw a little\u2019un leave moments ago. Parents are gone, little\u2019un
      gone\u2026 It should be empty.\""
    m_Metadata:
      m_Items: []
  - m_Id: 16965116889411584
    m_Localized: '"Then put some backbone into it and bust the door you imbeciles!"'
    m_Metadata:
      m_Items: []
  - m_Id: 17016795164848128
    m_Localized: Neas hurried back to his room, hoping to hide from the raiders...
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
